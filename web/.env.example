# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres — local dev uses Unix socket
DATABASE_URL=postgresql://david@localhost/pwc?host=/var/run/postgresql

# GitHub OAuth App
# Create at: github.com → Settings → Developer Settings → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret

# NextAuth
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Admin
# Find your numeric GitHub ID at: https://api.github.com/users/YOUR_USERNAME
ADMIN_GITHUB_ID=your_numeric_github_id

# Optional: accounts younger than this many days get flagged (default 180)
GITHUB_MIN_ACCOUNT_AGE_DAYS=180
